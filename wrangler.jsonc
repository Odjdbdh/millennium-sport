{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "millennium-sport",
  "compatibility_date": "2026-07-22",
  "main": "./worker/index.ts",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "STORIES_DB",
      "database_name": "millennium-sport-stories-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORY_MEDIA",
      "bucket_name": "millennium-sport-story-media"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
